# 网页后端环境模板（示例值；复制为 backend.web.env 并在服务器上填写，backend.web.env 不进 git）。
# 这里不含、也不应该出现任何真实密钥。

# 必填：≥32 字节随机值（例如 python -c "import secrets;print(secrets.token_hex(32))" 在服务器上生成）
PETJOURNEY_AUTH_SECRET=__REPLACE_ON_SERVER__
PETJOURNEY_WEB_COOKIE_SECURE=true
PETJOURNEY_WEB_SESSION_TTL_SECONDS=2592000

# 公网地址（同源）；只列必要来源，不用 *
PETJOURNEY_PUBLIC_BASE_URL=https://web.example.invalid
PETJOURNEY_CORS_ORIGINS=https://web.example.invalid

# 旧接口：纯网页部署用 closed；与 iOS 共用时用 owner_bearer（先实测 iOS）。禁止 open。
PETJOURNEY_LEGACY_API_POLICY=closed
PETJOURNEY_APPLE_AUTH_MODE=live

# 单实例
PETJOURNEY_SCHEDULER_ENABLED=false

# 意图判断层：默认关闭；开启 shadow/assist 需要单独评审
PETJOURNEY_INTENT_LAYER_MODE=off
PETJOURNEY_INTENT_LAYER_PROVIDER=rule

# 网页真实供应商总开关（默认关闭）与每日调用上限；开启后只在服务端调用
PETJOURNEY_WEB_PROVIDERS=off
PETJOURNEY_WEB_LLM_DAILY_CAP=300
PETJOURNEY_WEB_IMAGE_DAILY_CAP=20
PETJOURNEY_WEB_MAP_DAILY_CAP=500
# 网页底图（高德静态地图，港澳范围；每人每日另限 40 张新图）
PETJOURNEY_WEB_MAP_STATIC_DAILY_CAP=200
# 世界定时器（秒；0 关闭）：推进旅程、TA 自己的决定、排队回复与主动消息
PETJOURNEY_WEB_WORLD_TICK_SECONDS=30
# 网页生图模型（Seedream 4.5，至少 2048x2048）
PETJOURNEY_WEB_IMAGE_MODEL=doubao-seedream-4-5-251128

# 供应商（地图/模型/生图/时刻表）：未获得付费调用授权前保持 mock / 留空。
# 留空时对应能力在 /api/v1/web/meta 显示 not_configured，页面如实提示，不伪造数据。
PETJOURNEY_PROVIDER_MODE=mock
PETJOURNEY_MAP_PROVIDER=mock
PETJOURNEY_LLM_PROVIDER=mock
PETJOURNEY_IMAGE_PROVIDER=mock
PETJOURNEY_TRANSPORT_SCHEDULE_PROVIDER=mock
AMAP_API_KEY=
GOOGLE_MAPS_API_KEY=
OPENAI_API_KEY=
DOUBAO_API_KEY=

# ---- 0.4.0 真实体验（见 deploy/web/REAL-EXPERIENCE-DEPLOY.md）----
# 世界由谁推进：embedded（API 进程内，本地开发）/ worker（独立任务进程 python -m app.web_worker，生产）/ off
PETJOURNEY_WEB_WORLD_RUNNER=worker
# 0.4.1：任务进程里有两条线，各有一份数据库租约——世界线（到期结算、家庭来信、出门前复核、规则生活、驾校）
# 与认知线（攻略与相遇的表达、到点回复、主动消息）。模型卡住只影响认知线，不影响工资与到站。
# 心跳策略（web_runtime）：shadow＝只评估并记录每宠运行状态，不执行、不调模型（默认）；off＝不跑
PETJOURNEY_WEB_HEARTBEAT_MODE=shadow
# 模型自主决策（web_agent.decision）：off＝一次模型都不调用（默认，保持现有规则生活）；shadow＝调用但只记录；live＝复核后真的执行
# 打开 live / shadow 会产生真实的模型调用，按每宠每个 UTC 记账日上限计费，且不超过供应商本身的上限；先确认预算再改
PETJOURNEY_WEB_BRAIN_MODE=off
PETJOURNEY_WEB_BRAIN_DAILY_PER_PET=12
# API 与任务进程并发读写时打开 SQLite WAL
PETJOURNEY_SQLITE_WAL=1
# 环境标签（只用于 /ops/status 报告）：dev / demo / real-local / staging / production
PETJOURNEY_WEB_ENVIRONMENT=production
# 演示线路与“示例”地点：只给明确的演示站，正式环境不设置
# PETJOURNEY_WEB_DEMO_CATALOG=1
# /ops/status 在 staging/production 需要 X-Admin-Token（值为下面这个，服务器上生成，不进 git）
PETJOURNEY_ADMIN_TOKEN=__REPLACE_ON_SERVER__
