{
  "name": "petsoul-web",
  "private": true,
  "version": "0.1.0",
  "description": "PetSoul 2.0 mobile web client (R0 framework)",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:fixture": "vite --mode fixture",
    "dev:live": "vite --mode live",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "contract:check": "python ../scripts/gen_web_contract.py --check",
    "contract:gen": "python ../scripts/gen_web_contract.py"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
